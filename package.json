{
  "name": "dsh-state-notifier",
  "version": "0.1.0",
  "description": "DeepSeek Harness 的完成、审批、提问、受阻和错误通知",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.12" },
  "main": "src/index.js",
  "exports": { ".": "./src/index.js", "./client": "./dist/client.js", "./package.json": "./package.json" },
  "files": ["src/index.js", "src/core.js", "src/journal.js", "dist/client.js", "cordis.patch.yml", "README.md", "CHANGELOG.md", "LICENSE"],
  "dsh": {
    "category": "notify",
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-connection", "@deepseek-ai/dsh-client-ui-renderer"] }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": { "@deepseek-ai/schemastery": "~3.18.4" },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.4" },
  "devDependencies": { "@deepseek-ai/cordis": "4.0.4", "@deepseek-ai/dsh-session": "0.2.0-rc.2", "esbuild": "0.28.2" }
}
